PAYMENT_MOCK_TAXPAYER_NAME=TestDriver UAT
PAYMENT_MOCK_TAX_ID=1101700203451
PAYMENT_MOCK_TAX_ADDRESS=404 Moo 18, Chum Phae, Khon Kaen 40130
PAYMENT_MOCK_IS_HEAD_OFFICE=true
