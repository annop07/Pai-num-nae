generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String              @id @default(cuid())
  username                String              @unique
  email                   String              @unique
  password                String
  firstName               String?
  lastName                String?
  gender                  String?
  phoneNumber             String?
  profilePicture          String?
  nationalIdNumber        String?             @unique
  nationalIdPhotoUrl      String?             @unique
  nationalIdExpiryDate    DateTime?
  selfiePhotoUrl          String?
  role                    Role                @default(PASSENGER)
  isVerified              Boolean             @default(false)
  isActive                Boolean             @default(true)
  otpCode                 String?
  lastLogin               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  driverSuspendedUntil    DateTime?
  passengerSuspendedUntil DateTime?
  bookings                Booking[]           @relation("PassengerBookings")
  driverVerification      DriverVerification?
  notification            Notification[]
  createdRoutes           Route[]             @relation("DriverRoutes")
  vehicles                Vehicle[]

  //Relations
  reportedIncidents    Incident[]          @relation("ReporterIncidents")
  incidentsAgainst     Incident[]          @relation("ReportedUserIncidents")
  resolvedIncidents    Incident[]          @relation("ResolverIncidents")
  incidentStatusLogs   IncidentStatusLog[] @relation("AdminStatusChanges")
  driverTaxProfile     DriverTaxProfile?
  paymentConfirmationsAsPassenger PaymentConfirmation[] @relation("PaymentConfirmationPassenger")
  paymentConfirmationsAsDriver    PaymentConfirmation[] @relation("PaymentConfirmationDriver")
  paymentConfirmationsConfirmed   PaymentConfirmation[] @relation("PaymentConfirmationConfirmer")
  paymentProofSubmissions         PaymentProofSubmission[] @relation("PaymentProofSubmittedBy")
  paymentProofReviews             PaymentProofSubmission[] @relation("PaymentProofReviewedBy")
  issuedPaymentDocuments          PaymentDocument[] @relation("PaymentDocumentIssuer")
  receivedPaymentDocuments        PaymentDocument[] @relation("PaymentDocumentReceiver")
  paymentAuditLogs                PaymentAuditLog[] @relation("PaymentAuditActor")

  @@index([role])
  @@index([isActive])
  @@index([isVerified])
  @@index([createdAt])
}

model DriverVerification {
  id                 String             @id @default(cuid())
  userId             String             @unique
  licenseNumber      String             @unique
  firstNameOnLicense String
  lastNameOnLicense  String
  licenseIssueDate   DateTime
  licenseExpiryDate  DateTime
  licensePhotoUrl    String
  selfiePhotoUrl     String
  typeOnLicense      LicenseType
  status             VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([licenseIssueDate])
  @@index([licenseExpiryDate])
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  type            NotificationType @default(SYSTEM)
  title           String
  body            String
  link            String?
  metadata        Json?            @db.Json
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  adminReviewedAt DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  incidentsId String?
  incident    Incident? @relation("IncidentNotifications", fields: [incidentsId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([adminReviewedAt])
}

model Vehicle {
  id           String   @id @default(cuid())
  userId       String
  vehicleModel String
  licensePlate String   @unique
  vehicleType  String
  color        String
  seatCapacity Int
  amenities    String[]
  photos       Json?    @db.Json
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  routes       Route[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([vehicleType])
  @@index([seatCapacity])
}

model Route {
  id              String      @id @default(cuid())
  driverId        String
  vehicleId       String
  startLocation   Json        @db.Json
  endLocation     Json        @db.Json
  departureTime   DateTime
  availableSeats  Int
  pricePerSeat    Float
  conditions      String?
  status          RouteStatus @default(AVAILABLE)
  routeSummary    String?
  distance        String?
  duration        String?
  waypoints       Json?       @db.Json
  landmarks       Json?       @db.Json
  steps           Json?       @db.Json
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  routePolyline   String?
  distanceMeters  Int?
  durationSeconds Int?
  cancelledAt     DateTime?
  cancelledBy     String?
  bookings        Booking[]
  paymentConfirmations PaymentConfirmation[]
  driver          User        @relation("DriverRoutes", fields: [driverId], references: [id], onDelete: Cascade)
  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  incidents       Incident[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([departureTime])
}

model Booking {
  id              String        @id @default(cuid())
  routeId         String
  passengerId     String
  numberOfSeats   Int
  status          BookingStatus @default(PENDING)
  pickupLocation  Json          @db.Json
  dropoffLocation Json          @db.Json
  createdAt       DateTime      @default(now())
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    CancelReason?
  passenger       User          @relation("PassengerBookings", fields: [passengerId], references: [id], onDelete: Cascade)
  route           Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  incidents       Incident[]
  paymentConfirmation PaymentConfirmation?
}

model DriverTaxProfile {
  id           String       @id @default(cuid())
  driverId     String       @unique
  taxpayerType TaxpayerType @default(INDIVIDUAL)
  taxpayerName String
  taxId        String       @unique
  branchCode   String?
  isHeadOffice Boolean      @default(true)
  taxAddress   String
  email        String?
  phoneNumber  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  driver       User         @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model PaymentConfirmation {
  id                 String                    @id @default(cuid())
  bookingId          String                    @unique
  routeId            String
  passengerId        String
  driverId           String
  expectedAmount     Decimal                   @db.Decimal(12, 2)
  paidAmount         Decimal?                  @db.Decimal(12, 2)
  currency           String                    @default("THB") @db.VarChar(3)
  receiverRole       PaymentReceiverRole       @default(DRIVER)
  status             PaymentConfirmationStatus @default(UNPAID)
  latestSubmissionId String?                   @unique
  confirmedAt        DateTime?
  confirmedById      String?
  disputedAt         DateTime?
  disputeReason      String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  booking          Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  route            Route                    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  passenger        User                     @relation("PaymentConfirmationPassenger", fields: [passengerId], references: [id], onDelete: Cascade)
  driver           User                     @relation("PaymentConfirmationDriver", fields: [driverId], references: [id], onDelete: Cascade)
  confirmedBy      User?                    @relation("PaymentConfirmationConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  latestSubmission PaymentProofSubmission?  @relation("PaymentLatestSubmission", fields: [latestSubmissionId], references: [id], onDelete: SetNull)
  proofSubmissions PaymentProofSubmission[] @relation("PaymentProofHistory")
  documents        PaymentDocument[]
  auditLogs        PaymentAuditLog[]

  @@index([routeId])
  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

model PaymentProofSubmission {
  id                    String              @id @default(cuid())
  paymentConfirmationId String
  submittedById         String
  reviewedById          String?
  submissionNo          Int
  paymentMethod         OffAppPaymentMethod
  paidAt                DateTime
  amount                Decimal             @db.Decimal(12, 2)
  referenceNo           String?
  note                  String?             @db.Text
  isCorporateRequest    Boolean             @default(false)
  companyName           String?
  companyTaxId          String?
  companyBranchCode     String?
  companyAddress        String?
  reviewStatus          ProofReviewStatus   @default(PENDING)
  rejectReason          String?             @db.Text
  reviewedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  paymentConfirmation   PaymentConfirmation   @relation("PaymentProofHistory", fields: [paymentConfirmationId], references: [id], onDelete: Cascade)
  submittedBy           User                  @relation("PaymentProofSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy            User?                 @relation("PaymentProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  evidenceFiles         PaymentEvidenceFile[]
  latestForConfirmation PaymentConfirmation?  @relation("PaymentLatestSubmission")

  @@unique([paymentConfirmationId, submissionNo])
  @@index([paymentConfirmationId, createdAt])
  @@index([submittedById])
  @@index([reviewStatus])
}

model PaymentEvidenceFile {
  id                  String   @id @default(cuid())
  paymentSubmissionId String
  fileUrl             String
  mimeType            String?
  fileName            String?
  fileSizeBytes       Int?
  createdAt           DateTime @default(now())

  paymentSubmission PaymentProofSubmission @relation(fields: [paymentSubmissionId], references: [id], onDelete: Cascade)

  @@index([paymentSubmissionId])
  @@index([createdAt])
}

model PaymentDocument {
  id                    String                @id @default(cuid())
  paymentConfirmationId String
  documentType          PaymentDocumentType
  status                PaymentDocumentStatus @default(ISSUED)
  documentNumber        String                @unique
  issuedById            String
  issuedToId            String
  issuedAt              DateTime              @default(now())
  paidAt                DateTime?
  paymentMethod         OffAppPaymentMethod
  referenceNo           String?
  currency              String                @default("THB") @db.VarChar(3)
  subtotal              Decimal               @db.Decimal(12, 2)
  taxAmount             Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal               @db.Decimal(12, 2)
  payerName             String
  payerTaxId            String?
  payerAddress          String?
  payeeName             String
  payeeTaxId            String?
  payeeBranchCode       String?
  payeeAddress          String
  templateData          Json?                 @db.Json
  pdfUrl                String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  paymentConfirmation PaymentConfirmation @relation(fields: [paymentConfirmationId], references: [id], onDelete: Cascade)
  issuedBy            User                @relation("PaymentDocumentIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  issuedTo            User                @relation("PaymentDocumentReceiver", fields: [issuedToId], references: [id], onDelete: Cascade)

  @@unique([paymentConfirmationId, documentType])
  @@index([documentType])
  @@index([issuedById])
  @@index([issuedToId])
  @@index([createdAt])
}

model PaymentAuditLog {
  id                    String                     @id @default(cuid())
  paymentConfirmationId String
  fromStatus            PaymentConfirmationStatus?
  toStatus              PaymentConfirmationStatus
  action                PaymentAuditAction
  note                  String?                    @db.Text
  metadata              Json?                      @db.Json
  actionById            String
  createdAt             DateTime                   @default(now())

  paymentConfirmation PaymentConfirmation @relation(fields: [paymentConfirmationId], references: [id], onDelete: Cascade)
  actionBy            User                @relation("PaymentAuditActor", fields: [actionById], references: [id], onDelete: Cascade)

  @@index([paymentConfirmationId])
  @@index([actionById])
  @@index([createdAt])
}

model Incident {
  id             String           @id @default(cuid())
  reporterId     String
  reportedUserId String?
  routeId        String?
  bookingId      String?
  type           IncidentType
  status         IncidentStatus   @default(PENDING)
  priority       IncidentPriority @default(NORMAL)
  title          String
  description    String           @db.Text
  location       Json?            @db.Json
  evidenceUrls   String[]
  metadata       Json?            @db.Json
  resolvedBy     String?
  resolvedAt     DateTime?
  resolution     String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  parentIncidentId String?
  revisionNumber   Int              @default(1)
  isArchived       Boolean          @default(false)

  //Relations
  reporter      User           @relation("ReporterIncidents", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser  User?          @relation("ReportedUserIncidents", fields: [reportedUserId], references: [id], onDelete: SetNull)
  resolver      User?          @relation("ResolverIncidents", fields: [resolvedBy], references: [id], onDelete: SetNull)
  route         Route?         @relation(fields: [routeId], references: [id], onDelete: SetNull)
  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  notifications Notification[] @relation("IncidentNotifications")
  parent        Incident?       @relation("IncidentLineage", fields: [parentIncidentId], references: [id], onDelete: SetNull)
  children      Incident[]      @relation("IncidentLineage")
  statusLogs    IncidentStatusLog[]

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([routeId])
  @@index([bookingId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([parentIncidentId])
  @@index([isArchived])
}

model IncidentStatusLog {
  id          String               @id @default(cuid())
  incidentId  String
  fromStatus  IncidentStatus?
  toStatus    IncidentStatus
  reason      StatusChangeReason
  note        String?              @db.Text
  changedById String
  createdAt   DateTime             @default(now())

  incident  Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  changedBy User     @relation("AdminStatusChanges", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([createdAt])
  @@index([changedById])
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RouteStatus {
  AVAILABLE
  FULL
  COMPLETED
  CANCELLED
  IN_TRANSIT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum CancelReason {
  CHANGE_OF_PLAN
  FOUND_ALTERNATIVE
  DRIVER_DELAY
  PRICE_ISSUE
  WRONG_LOCATION
  DUPLICATE_OR_WRONG_DATE
  SAFETY_CONCERN
  WEATHER_OR_FORCE_MAJEURE
  COMMUNICATION_ISSUE
}

enum LicenseType {
  PRIVATE_CAR_TEMPORARY
  PRIVATE_CAR
  PUBLIC_CAR
  LIFETIME
}

enum NotificationType {
  SYSTEM
  VERIFICATION
  BOOKING
  ROUTE
  INCIDENT
}

enum IncidentType {
  SAFETY_CONCERN
  INAPPROPRIATE_BEHAVIOR
  HARASSMENT
  ACCIDENT
  VEHICLE_ISSUE
  FRAUD
  ROUTE_ISSUE
  PAYMENT_DISPUTE
  LOST_ITEM
  NO_SHOW_DRIVER
  NO_SHOW_PASSENGER
  LICENSE_PLATE_MISMATCH
  OTHER
}

enum IncidentStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
  ESCALATED
}

enum IncidentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StatusChangeReason {
  EVIDENCE_REVIEWED
  POLICY_VIOLATION
  INSUFFICIENT_EVIDENCE
  FALSE_REPORT
  MATTER_RESOLVED
  REQUIRES_ESCALATION
  REOPENED
  OTHER
}

enum PaymentConfirmationStatus {
  UNPAID
  PROOF_SUBMITTED
  CONFIRMED
  DISPUTED
}

enum OffAppPaymentMethod {
  CASH
  BANK_TRANSFER
  PROMPTPAY
  QR_CODE
  OTHER
}

enum PaymentReceiverRole {
  DRIVER
  PASSENGER
  OTHER
}

enum ProofReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentDocumentType {
  RECEIPT
  TAX_INVOICE
  PAYMENT_VOUCHER
}

enum PaymentDocumentStatus {
  ISSUED
  VOIDED
}

enum TaxpayerType {
  INDIVIDUAL
  COMPANY
}

enum PaymentAuditAction {
  PROOF_SUBMITTED
  PROOF_CONFIRMED
  PROOF_REJECTED
  PROOF_RESUBMITTED
  DOCUMENT_ISSUED
  STATUS_UPDATED
}

