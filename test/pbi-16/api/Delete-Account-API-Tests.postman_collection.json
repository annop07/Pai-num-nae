              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ลบบัญชีไม่ได้เมื่อมี Booking Active (400)', function () {",
                  "    pm.response.to.have.status(400);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.include('active bookings');",
                  "});",
                  "",
                  "pm.test('data เป็น null', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.null;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
